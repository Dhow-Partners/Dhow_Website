{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/whatsapp",
      "destination": "https://wa.me/message/HJAYDBSILGGWM1",
      "permanent": false
    },
    {
      "source": "/wa",
      "destination": "https://wa.me/message/HJAYDBSILGGWM1",
      "permanent": false
    },
    {
      "source": "/brand",
      "destination": "https://brandfetch.com/dhowpartners.com",
      "permanent": false
    },
    {
      "source": "/blog",
      "destination": "https://medium.com/@dhowpartners",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(src|tools)/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/dc/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/support.min.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/:file(.*\\.css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/:file(.*\\.(?:webp|png|jpg|jpeg|svg|ico))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
